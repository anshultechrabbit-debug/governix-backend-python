# Copy to .env. Only DATABASE_URL is required locally.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql://postgres:password@localhost:5432/governix
# DB pool sizing. The hybrid retrieval runs 4 SQL lanes in parallel per request
# on a shared 8-thread pool (LANE_POOL_SIZE). Peak connections per worker:
#   peak = LANE_POOL_SIZE + 4 (main request + overhead)
# For N Uvicorn workers each handling M concurrent RAG requests:
#   total = N × M × 4 lanes = N × M × 4
# Local (1 worker): DB_POOL_SIZE=12, DB_MAX_OVERFLOW=8 is safe.
# Production (4 workers, 2 concurrent each): DB_POOL_SIZE=20, DB_MAX_OVERFLOW=16.
# Overflow connections are short-lived; set DB_MAX_OVERFLOW > DB_POOL_SIZE / 2.
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

QUEUE_BACKEND=local
WORKER_MODE=in_process          # in_process | distributed (python -m app.workers) | disabled
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=300

# MEMORY is process-local: correct for a single worker, useless once you run
# more than one (each process keeps its own copy; hit rate = 1/N workers).
# *** Production multi-worker deployments MUST set CACHE_BACKEND=redis ***
CACHE_BACKEND=memory
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

OCR_BACKEND=local
# For OCR_BACKEND=cloud: a secured internal/vendor gateway that accepts a PNG
# page payload and responds with {"text": "..."}.
# CLOUD_OCR_URL=https://ocr.example.internal/v1/page
# CLOUD_OCR_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
RERANKER_PROVIDER=local
OPENAI_API_KEY=
# Dashboard credit view. OpenAI does not let an API key read its balance: state the
# credit you added and the date you added it; spend since then is subtracted.
# OPENAI_CREDIT_USD=10
# OPENAI_CREDIT_SINCE=2026-10-01
# Optional organization Admin key (sk-admin-...) for exact spend from OpenAI's Costs API.
# OPENAI_ADMIN_KEY=

# RAG recall budget. RAG_EVIDENCE_LIMIT is the number of passages handed to the
# model: raising it improves recall on multi-fact questions and costs tokens and
# validation strictness. RAG_DEADLINE_SECONDS is checked before the model call
# and must stay below LLM_TIMEOUT_SECONDS, which is what bounds the call itself;
# worst case for one answer is roughly
# LLM_TIMEOUT_SECONDS * (1 + LLM_TRUNCATION_RETRIES).
# RAG_EVIDENCE_LIMIT=14
# RAG_RERANK_TOP_N=24
# RAG_RETRIEVAL_CANDIDATES=80
# LLM_TIMEOUT_SECONDS=30
# RAG_DEADLINE_SECONDS=20
# Reasoning effort for reasoning models (gpt-5 family, o-series); ignored by others.
# low | minimal | medium | high. "low" measured at the same accuracy as the model
# default with ~2.4x lower median latency.
# LLM_REASONING_EFFORT=low

# Previous-version fallback: when the current version has no answer, search up
# to RAG_FALLBACK_MAX_DEPTH earlier versions. Lower this (e.g. 1) for
# latency-sensitive deployments; set RAG_PREVIOUS_VERSION_FALLBACK=false to disable.
# RAG_FALLBACK_MAX_DEPTH=3
# RAG_PREVIOUS_VERSION_FALLBACK=true

# Per-principal rate limit on /ai/ask, the only route that spends LLM budget.
# In-process: bounds the per-worker rate. Put a shared limiter at the edge for a
# hard global ceiling. Cannot be disabled when APP_ENV=production.
# RAG_RATE_LIMIT_REQUESTS=20
# RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Production infrastructure
# APP_ENV=production
# LOG_JSON=true
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# QUEUE_BACKEND=celery
# WORKER_MODE=distributed
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=<at-least-32-random-characters>
# # Worker command: celery -A app.workers.celery_app worker --loglevel=INFO
# # Production DB pool (4 workers × 2 concurrent requests):
# # DB_POOL_SIZE=20
# # DB_MAX_OVERFLOW=16
